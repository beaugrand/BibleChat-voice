   "facts": [
    {
     "text": "The word for \"image\" is tselem. Strong's gives it as \"an idolatrous figure\".",
     "refs": [
      "Daniel 2:31"
     ],
     "strongs": [
      "H6755"
     ]
    },
    {
     "text": "Head \"of fine gold\", breast and arms \"of silver\", belly and thighs \"of brass\", legs \"of iron\", feet \"part of iron and part of clay\".",
     "refs": [
      "Daniel 2:32-33"
     ]
    },
    {
     "text": "\"cut out\" is gezar: \"to quarry\". The text does not say who cut the stone, only that it was \"without hands\".",
